# Maintainer: Mike <mike@example.com>
pkgname=garuda-pilot
pkgver=0.1.0
pkgrel=1
pkgdesc="Upgrade management dashboard for Garuda Linux and Arch-based distros"
arch=('any')
url="https://github.com/interceptor/garuda-pilot"
license=('MIT')
depends=(
    'python>=3.11'
    'python-fastapi'
    'python-uvicorn'
    'python-jinja'
    'python-aiosqlite'
    'python-httpx'
    'pacman-contrib'
    'pciutils'
)
makedepends=(
    'python-build'
    'python-installer'
    'python-poetry-core'
)
optdepends=(
    'garuda-update: recommended upgrade method'
    'garuda-health: system health checks'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${pkgname}-${pkgver}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${pkgname}-${pkgver}"
    python -m installer --destdir="${pkgdir}" dist/*.whl
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
